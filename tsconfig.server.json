{
  /*
   * Type-checks the serverless functions. NOT part of `npm run build` — the
   * host compiles these itself, and wiring them into the site build is what
   * made a missing directory able to break a deploy.
   *
   * Run on demand:  npm run typecheck:server
   */
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    /*
     * Relative imports in api/ carry an explicit .ts extension, because
     * package.json declares "type": "module" and Node's ESM resolver does not
     * accept extensionless specifiers — an extensionless import made the
     * function fail to load at runtime with ERR_MODULE_NOT_FOUND. This flag
     * lets the type-checker accept the extension that the runtime requires.
     * tsconfig.json (the app) already sets the same flag.
     */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["api/**/*.ts", "netlify/**/*.ts"]
}
