# ---------------------------------------------------------------------------
# Server-side secrets. Copy to .env.local for local development, and set the
# same values in your host's dashboard (Vercel: Settings → Environment
# Variables) for production.
#
# .env.local is git-ignored. NEVER commit a real key.
# These are read only by api/_lib/lead-core.ts, which runs on the server.
# ---------------------------------------------------------------------------

# REQUIRED — Follow Up Boss API key.
# Find it in Follow Up Boss: Admin → API.
FOLLOW_UP_BOSS_API_KEY=

# OPTIONAL — only if you have registered an integration with Follow Up Boss.
# Leave blank for a plain API-key integration on your own account.
FUB_SYSTEM=
FUB_SYSTEM_KEY=

# OPTIONAL — event type recorded in Follow Up Boss.
# Must be one of the types FUB accepts; "Seller Inquiry" is the right one here.
FUB_LEAD_TYPE=Seller Inquiry

# OPTIONAL — an extra tag applied to every person created from this page,
# handy for building a smart list. Example: Seller LP 2026
FUB_ASSIGNED_TAG=

# OPTIONAL — the lead source recorded in Follow Up Boss. Defaults to the
# landing page's own hostname. The ad campaign that drove the click is kept
# separately, in the contact's note and tags.
FUB_SOURCE=
